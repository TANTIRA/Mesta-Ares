# Dev image for the Next.js console at apps/console.
# Build context is the repo root (see docker-compose).
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app
# Only package.json is copied here so the layer survives missing lockfiles;
# pnpm resolves fresh (frozen-lockfile=false) until a pnpm-lock.yaml lands.
COPY apps/console/package.json ./
RUN pnpm install --frozen-lockfile=false
COPY apps/console ./

# API access is same-origin via app/api/proxy: ARES_API_URL points the
# server-side proxy at the upstream, ARES_CONSOLE_KEY is the injected key.
ENV ARES_API_URL=http://api-gateway:8082

EXPOSE 3000
CMD ["pnpm", "dev"]
