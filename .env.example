# Mesta-Ares dev environment — copy to .env and fill in real values.
# docker compose -f infra/docker-compose.yml auto-loads .env from the repo root.
# NEVER commit the real .env (gitignored, keep it chmod 600).
# .env.local is a separate local file — leave it alone.

# ---- Service-to-service + edge auth -----------------------------------------
# `sh infra/gen-dev-keys.sh` fills all four of these for you.
#
# ARES_API_KEYS gates api-server/tool-server/ingestion-gateway.
# Spec: `key:actor[:role],...` — role `approver` is required to decide
# approvals; a caller can never approve its own request.
ARES_API_KEYS=
# Key agents present when calling tool-server (must appear in ARES_API_KEYS).
ARES_TOOL_KEY=
# Key the console's server-side proxy injects (never reaches the browser).
ARES_CONSOLE_KEY=
# Set =1 to refuse boot when no keys / weak keys (<32 chars) are configured.
# Without it, an empty key set runs unauthenticated (local dev only).
ARES_REQUIRE_AUTH=

# ---- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
#ANTHROPIC_BASE_URL=            # Ollama: http://localhost:11434 (key: ollama) or https://ollama.com (key: Ollama API key)
# API gateway (crates/api-gateway) — single entry point on :8082.
# Comma-separated keys; clients send `Authorization: Bearer <key>` or `X-API-Key`.
GATEWAY_API_KEYS=
# Dev only: allow unauthenticated requests when GATEWAY_API_KEYS is empty.
# Leave blank in any shared environment — gen-dev-keys.sh fills the keys.
GATEWAY_ALLOW_ANONYMOUS=
# Optional overrides (defaults shown):
#GATEWAY_API_UPSTREAMS=http://localhost:8080
#GATEWAY_INGEST_UPSTREAMS=http://localhost:8091
#GATEWAY_TOOLS_UPSTREAMS=http://localhost:8090
#GATEWAY_CACHE_TTL_SECONDS=30
#GATEWAY_CACHE_PREFIXES=/api/vulns

# Optional: local Ollama decision model for triage verdicts (e.g. tev1:4b or nimble).
# When set, triage asks /v1/systemone for the verdict + severity; the LLM is the fallback.
#DECISION_MODEL=
#OLLAMA_BASE_URL=http://localhost:11434
#FAST_MODEL=claude-haiku-4-5    # tier model overrides, e.g. Ollama tags
#STRONG_MODEL=claude-sonnet-4-6

# ---- Enrichment / threat intel ---------------------------------------------
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# ---- SOAR integrations ------------------------------------------------------
# TheHive: create org + service account in http://localhost:9000 after first boot
THEHIVE_API_KEY=
# Optional: pin a real Play framework secret instead of the compose dev default
#THEHIVE_APPLICATION_SECRET=

# MISP (github.com/MISP/misp-docker): ADMIN_KEY becomes the automation key on
# first boot — set MISP_API_KEY here once and both MISP and our connectors use it.
MISP_API_KEY=
MISP_ADMIN_PASSWORD=admin
MISP_BASE_URL=https://localhost:8443
MISP_MYSQL_USER=misp
MISP_MYSQL_PASSWORD=misp
MISP_MYSQL_DATABASE=misp
MISP_MYSQL_ROOT_PASSWORD=misp_root
MISP_REDIS_PASSWORD=redispassword
# Optional: `source` recorded on sightings the response agent pushes back to MISP.
MISP_SIGHTING_SOURCE=ares
# Optional: NVD API key for CVE enrichment context
NVD_API_KEY=

# Shuffle: Settings -> API after logging in at http://localhost:3001
SHUFFLE_API_KEY=

# ---- Wazuh ------------------------------------------------------------------
WAZUH_API_USER=wazuh-wui
# Set inside the container via wazuh-passwd-tool, then mirror here
WAZUH_API_PASS=

# ---- NVD vulnerability intel -------------------------------------------------
# Optional NVD API key — raises the client rate limit ~10x (50 req/30s).
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# vuln-agent tuning
#VULN_POLL_INTERVAL=3600   # seconds between NVD polls
#VULN_LOOKBACK_HOURS=24    # published-CVE window per poll
#VULN_MIN_SEVERITY=high    # low|medium|high|critical

# ---- Misc -------------------------------------------------------------------
RUST_LOG=info
# OPENSEARCH_INITIAL_ADMIN_PASSWORD=  # only needed if the security plugin is re-enabled

# ---- Keycloak (infra/keycloak) ----
# Provider build refs — pin to tags/SHAs, not branches, outside dev.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak
KC_HOSTNAME=http://localhost:8180
# ADAPTIVE_AUTHN_REF=v1.0.0
# CAP_CAPTCHA_REF=main
# GEOAWARE_REF=main
# SECRETS_VAULT_REF=main
# SCIM_REF=main
# POW_REF=main
# MULTI_TENANCY_REF=main
# KEYCLOAKIFY_STARTER_REF=main
